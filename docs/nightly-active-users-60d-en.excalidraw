  {
   "type": "text",
   "id": "e26",
   "x": 70,
   "y": 967,
   "width": 860,
   "height": 70,
   "text": "Adds users, then removes users, in Graph batches of 20.\nSAFETY CAP: if removals exceed 10% of the target group, nobody is removed.\nFailed items are counted and retried the next night.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#000000",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 1,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "containerId": null,
   "originalText": "Adds users, then removes users, in Graph batches of 20.\nSAFETY CAP: if removals exceed 10% of the target group, nobody is removed.\nFailed items are counted and retried the next night.",
