  },
  {
   "type": "text",
   "id": "e50",
   "x": 70,
   "y": 497,
   "width": 860,
   "height": 49,
   "text": "משתמשים שהתחברו ב-N הימים האחרונים (signInActivity ב-Graph), רק אם הם בקבוצת המקור.\nבנוסף משתמשים שנוצרו ב-N הימים האחרונים (תקופת חסד), כדי שחשבונות חדשים לא יוסרו.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "right",
   "verticalAlign": "top",
   "strokeColor": "#000000",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 1,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
